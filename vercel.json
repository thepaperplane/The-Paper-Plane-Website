{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/news",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/calendar",
      "schedule": "30 2 1 * *"
    }
  ]
}
